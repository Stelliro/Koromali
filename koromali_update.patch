+def _validate_preset(data: Dict[str, Any] | None) -> Dict[str, str]:
+    """Return a sanitized copy of a preset dict. Only str->str entries are kept."""
+    out: Dict[str, str] = {}
+    if not data:
+        return out
+    for k, v in data.items():
+        if isinstance(k, str) and isinstance(v, str):
+            out[k] = v
+    return out
 
