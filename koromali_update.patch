+PATCH_FENCE_RE = re.compile(
+    r"```(?:patch|diff)\s*(.*?)```",
+    re.DOTALL | re.IGNORECASE
+)
+HEADER_PATH_RE = re.compile(r"^\-\-\-\s+a/(.+)$", re.MULTILINE)
+HEADER_PATH_PLUS_RE = re.compile(r"^\+\+\+\s+b/(.+)$", re.MULTILINE)
 
+def _extract_first_path(patch_block: str) -> str | None:
+    # Prefer +++ b/path (destination), else --- a/path
+    m2 = HEADER_PATH_PLUS_RE.search(patch_block)
+    if m2:
+        return m2.group(1).strip()
+    m1 = HEADER_PATH_RE.search(patch_block)
+    if m1:
+        return m1.group(1).strip()
+    return None
 
