+def apply_patch(original: str, patch_text: str) -> str:
+    if '--- ' not in patch_text or '+++ ' not in patch_text or '@@' not in patch_text:
+        return patch_text
+    src = original.replace('\r\n','\n').replace('\r','\n').split('\n')
+    out: List[str] = []; pos = 0
+    hunks = list(_HUNK_RE.finditer(patch_text))
+    if not hunks: return patch_text
+    for hi, hm in enumerate(hunks):
+        copy_until = max(0, int(hm.group(1)) - 1)
+        out.extend(src[pos:copy_until]); pos = copy_until
+        hunk_end = hunks[hi+1].start() if hi+1 < len(hunks) else len(patch_text)
+        body = patch_text[hm.end():hunk_end]
+        for line in body.splitlines():
+            if not line:
+                out.append(''); 
+                if pos < len(src): pos += 1
+                continue
+            tag, text = line[0], line[1:]
+            if tag == ' ':
+                if pos < len(src):
+                    if src[pos] != text:
+                        try:
+                            new_pos = src.index(text, pos, min(len(src), pos+200))
+                            out.extend(src[pos:new_pos]); pos = new_pos
+                        except ValueError: pass
+                    out.append(text); pos += 1
+                else: out.append(text)
+            elif tag == '-':
+                if pos < len(src) and src[pos] == text: pos += 1
+                else:
+                    try:
+                        idx = src.index(text, pos, min(len(src), pos+200))
+                        out.extend(src[pos:idx]); pos = idx+1
+                    except ValueError: pass
+            elif tag == '+':
+                out.append(text)
+            else:
+                out.append(line)
+    out.extend(src[pos:]); return '\n'.join(out)
