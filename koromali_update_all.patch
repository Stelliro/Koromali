+def _split_patch_by_file(patch_text: str) -> List[Tuple[str, str]]:
+    files: List[Tuple[str,str]] = []
+    text = patch_text.replace('\r\n','\n').replace('\r','\n')
+    heads = list(re.finditer(r"^---\s+\S+\n\+\+\+\s+(\S+)", text, re.MULTILINE))
+    if not heads: return []
+    for i,m in enumerate(heads):
+        start = m.start(); path = m.group(1)
+        if path.startswith('a/') or path.startswith('b/'): path = path[2:]
+        end = heads[i+1].start() if i+1 < len(heads) else len(text)
+        files.append((path, text[start:end].strip()))
+    return files
 
+def _extract_file_from_header(code: str) -> str:
+    for line in code.splitlines()[:5]:
+        mm = re.search(r"(?i)\bfile\s*:\s*(.+)$", line.strip())
+        if mm: return mm.group(1).strip()
+    m = re.search(r"^\+\+\+\s+(\S+)", code, re.MULTILINE) or re.search(r"^---\s+(\S+)", code, re.MULTILINE)
+    if m:
+        path = m.group(1).strip()
+        if path.startswith('a/') or path.startswith('b/'): path = path[2:]
+        return path
+    return ""
 
+def parse_llm_response(text: str, project_root: str) -> List[Dict]:
+    changes: List[Dict] = []
+    for m in _FENCE_RE.finditer(text or ''):
+        label = (m.group(1) or '').strip().lower()
+        body = m.group(2)
+        if label not in {'patch','diff'}:
+            continue
+        per_file = _split_patch_by_file(body)
+        if per_file:
+            for path, chunk in per_file:
+                rel = os.path.relpath(path, start=project_root) if os.path.isabs(path) else path
+                changes.append({'type':'APPLY_PATCH','file_path':rel.replace('\\','/'),'content':chunk})
+                log.info(f"AI Patcher: parsed diff for {rel}")
+            continue
+        file_path = _extract_file_from_header(body)
+        if not file_path:
+            log.warning("AI Patcher: could not infer file path for a diff block; skipping."); continue
+        rel = os.path.relpath(file_path, start=project_root) if os.path.isabs(file_path) else file_path
+        changes.append({'type':'APPLY_PATCH','file_path':rel.replace('\\','/'),'content':body})
+        log.info(f"AI Patcher: parsed diff for {rel}")
+    return changes
 
